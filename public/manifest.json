{
  "manifest_version": 3,
  "name": "Imhotep Browser Sync",
  "version": "1.0.0",
  "description": "Zero-knowledge decentralized P2P browser sync for history and extensions across Chromium browsers.",
  "permissions": [
    "history",
    "storage",
    "management",
    "alarms",
    "notifications",
    "unlimitedStorage"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Imhotep Browser Sync",
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
